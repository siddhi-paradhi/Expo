# Google Analytics 4 (GA4) Configuration
# Measurement ID for Commedia Solutions Broadcast India 2026 Showcase: G-M60W5YXE1Y
# For local development: Set this in .env.local
# For Vercel production: Set VITE_GA_MEASUREMENT_ID in Vercel Project Settings > Environment Variables
VITE_GA_MEASUREMENT_ID=G-M60W5YXE1Y

# Formspree endpoint for Briefing Requests & Contact Form
# Get your form ID at https://formspree.io/
# Conventional Vite prefix:
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xvkzwqen
# Next.js compatibility prefix (supported via envPrefix in vite.config.ts):
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xvkzwqen

# Cryptographic Session Secret (Required for 60-Minute Visitor Access Expiry)
# Must be a minimum 32-byte (64 character) hex string generated with crypto.randomBytes(32).toString('hex')
# In Vercel Production: Add SESSION_SECRET to Vercel Project Settings > Environment Variables
# In Local Dev: Set SESSION_SECRET in .env or .env.local
SESSION_SECRET=YOUR_64_CHAR_HEX_SESSION_SECRET_HERE
